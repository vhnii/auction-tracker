doctype html
html(lang="et")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title OksjonTrack
    script(src="https://cdn.tailwindcss.com")
    script(src="https://unpkg.com/lucide@latest")
  body(class="min-h-screen bg-slate-50 flex" style="font-family: system-ui, -apple-system, sans-serif")
    form(method="get" action="/" class="flex w-full")
      div#sidebar-backdrop(class="fixed inset-0 z-30 bg-black/50 hidden md:hidden" onclick="toggleSidebar()")
      aside#filter-sidebar(class="w-60 bg-slate-900 text-slate-300 hidden md:flex flex-col flex-shrink-0 fixed inset-y-0 left-0 z-40 md:sticky md:top-0 md:h-screen")
        div(class="p-5 border-b border-slate-800 relative")
          button(type="button" onclick="toggleSidebar()" class="md:hidden absolute top-4 right-3 p-1.5 text-slate-500 hover:text-white transition-colors")
            i(data-lucide="x" style="width:16px;height:16px")
          a(href="/" class="flex items-center gap-2.5 mb-0.5 hover:opacity-80 transition-opacity")
            div(class="w-6 h-6 bg-amber-500 rounded-md flex items-center justify-center flex-shrink-0")
              i(data-lucide="home" style="width:13px;height:13px;color:white")
            span(class="text-white font-bold text-[15px] tracking-tight") OksjonTrack
          p(class="text-[11px] text-slate-500 pl-8") Kinnisvara oksjonid

        div(class="flex-1 overflow-y-auto p-4 space-y-6")
          div
            div(class="text-[10px] font-semibold text-slate-500 uppercase tracking-widest mb-2") Staatus
            select(name="status" onchange="this.form.submit()" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-500 transition-colors")
              option(value="active" selected=(status === 'active')) Käimasolevad
              option(value="upcoming" selected=(status === 'upcoming')) Registreerimine avatud
              option(value="ended" selected=(status === 'ended')) Lõppenud
              option(value="all" selected=(status === 'all')) Kõik

          div
            div(class="text-[10px] font-semibold text-slate-500 uppercase tracking-widest mb-2") Aeg
            select(name="time" onchange="this.form.submit()" class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-500 transition-colors")
              option(value="" selected=(time === '')) Kõik
              option(value="7" selected=(time === '7')) Kuni 7 päeva
              option(value="14" selected=(time === '14')) Kuni 14 päeva
              option(value="21" selected=(time === '21')) Kuni 21 päeva

          div
            div(class="text-[10px] font-semibold text-slate-500 uppercase tracking-widest mb-2") Hind (€)
            div(class="flex gap-2")
              input(type="number" name="priceMin" placeholder="Min" value=priceMin class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-amber-500 transition-colors")
              input(type="number" name="priceMax" placeholder="Max" value=priceMax class="w-full px-2.5 py-1.5 bg-slate-800 border border-slate-700 rounded-lg text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-amber-500 transition-colors")

          button(type="submit" class="w-full py-2 text-sm text-white font-semibold bg-amber-500 hover:bg-amber-600 rounded-lg transition-colors") Filtreeri

          if hasActiveFilters
            a(href="/" class="block w-full py-2 text-sm text-center text-slate-400 hover:text-white border border-slate-700 hover:border-slate-500 rounded-lg transition-colors") Tühjenda filtrid

        div(class="px-4 py-3 border-t border-slate-800 flex-shrink-0")
          p(class="text-[12px] text-slate-600 text-center") Allikas: oksjonikeskus.ee

      div(class="flex-1 flex flex-col min-w-0 overflow-hidden")
        header(class="sticky top-0 z-10 bg-white border-b border-slate-200 px-5 py-3 flex-shrink-0")
          div(class="flex items-center gap-3")
            button(type="button" onclick="toggleSidebar()" class="md:hidden flex items-center justify-center p-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:border-slate-300 transition-colors flex-shrink-0")
              i(data-lucide="sliders-horizontal" style="width:15px;height:15px")
            div(class="flex-1 relative")
              i(data-lucide="search" style="width:15px;height:15px" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none")
              input(type="text" name="search" placeholder="Otsi kinnisvara..." value=search class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 bg-slate-50 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-400 focus:ring-2 focus:ring-slate-200 transition-all")

            div(class="relative flex items-center")
              select(name="sort" onchange="this.form.submit()" class="pl-8 pr-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-sm text-slate-700 focus:outline-none focus:border-slate-400 cursor-pointer hover:border-slate-300 transition-colors")
                option(value="time-asc" selected=(sort === 'time-asc')) Aeg (lähim)
                option(value="price-asc" selected=(sort === 'price-asc')) Hind ↑
                option(value="price-desc" selected=(sort === 'price-desc')) Hind ↓
              i(data-lucide=(sort === 'price-desc' ? 'list-sort-descending' : 'list-sort-ascending') style="width:14px;height:14px" class="absolute left-2.5 text-slate-400 pointer-events-none")

            div(class="relative flex-shrink-0")
              div(class="flex")
                button#scrape-btn(type="button" onclick="scrapeNow()" class="flex items-center gap-1.5 px-3 py-2 rounded-l-xl border border-slate-200 bg-slate-50 text-sm text-slate-700 hover:border-slate-300 transition-colors")
                  i(data-lucide="refresh-cw" style="width:14px;height:14px")
                  span(class="hidden sm:inline") Uuenda andmeid
                button(type="button" onclick="toggleScrapeMenu()" class="flex items-center px-1.5 py-2 rounded-r-xl border border-l-0 border-slate-200 bg-slate-50 text-slate-700 hover:border-slate-300 transition-colors")
                  i(data-lucide="chevron-down" style="width:14px;height:14px")
              div#scrape-menu(class="hidden absolute right-0 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-lg z-20 py-1 min-w-max")
                button(type="button" onclick="scrapeNow(true)" class="w-full text-left px-3 py-2 text-sm text-slate-700 hover:bg-slate-50") Uuenda kõik andmeid

        div#stats-bar(class="bg-white border-b border-slate-100 px-5 py-3 flex items-center gap-5 flex-wrap")
          div(class="flex items-baseline gap-1.5")
            span(class="text-xl font-black text-slate-900 font-mono tabular-nums")= stats.count
            span(class="text-xs text-slate-400") oksjonit
          div(class="w-px h-4 bg-slate-100")
          div(class="flex items-baseline gap-1.5")
            span(class="text-sm font-bold text-slate-800 font-mono tabular-nums")= stats.lowestPriceLabel
            span(class="text-xs text-slate-400") madalaim alghind
          div(class="w-px h-4 bg-slate-100")
          div(class="flex items-baseline gap-1.5")
            span(class="text-sm font-bold text-slate-800 font-mono tabular-nums" data-ends-at=stats.soonestEndsAt)= stats.soonestLabel
            span(class="text-xs text-slate-400") lähim oksjon

        main(class="flex-1 p-5 overflow-y-auto")
          if items.length === 0
            div(class="flex flex-col items-center justify-center py-24 text-center")
              i(data-lucide="alert-circle" style="width:26px;height:26px;color:#cbd5e1")
              h3(class="text-base font-semibold text-slate-700 mt-4 mb-1") Ühtegi tulemust ei leitud
              p(class="text-sm text-slate-400") Muuda otsingut
          else
            div#auction-grid(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4")
              each item in items
                article(class="bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl transition-all duration-200 flex flex-col")
                  a(href=`/auction/${item.id}` class="relative aspect-[4/3] bg-slate-100 flex items-center justify-center flex-shrink-0 overflow-hidden")
                    if item.thumbnail
                      img(src=item.thumbnail alt="" loading="lazy" class="w-full h-full object-cover")
                    else
                      i(data-lucide="home" style="width:36px;height:36px;color:#e2e8f0")
                    div(class="absolute top-2.5 left-2.5")
                      if item.ended
                        if item.outcome === 'reappraisal'
                          span(class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-medium bg-red-50/95 text-red-700 border-red-200 backdrop-blur-sm shadow-sm")
                            span(class="w-1.5 h-1.5 rounded-full flex-shrink-0 bg-red-500")
                            span(class="font-mono font-semibold") Ümberhindamisel
                        else
                          span(class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-medium bg-slate-100/95 text-slate-500 border-slate-200 backdrop-blur-sm shadow-sm")
                            span(class="w-1.5 h-1.5 rounded-full flex-shrink-0 bg-slate-400")
                            span(class="font-mono font-semibold") Lõppenud #{item.endedAt}
                      else if item.upcoming
                        span(class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-medium bg-blue-50/95 text-blue-700 border-blue-200 backdrop-blur-sm shadow-sm")
                          span(class="w-1.5 h-1.5 rounded-full flex-shrink-0 bg-blue-500")
                          span(class="font-mono font-semibold tabular-nums") Algab: #{item.timeLeft}
                      else
                        span(class=`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-medium backdrop-blur-sm shadow-sm ${item.daysLeft <= 7 ? 'bg-red-50/95 text-red-700 border-red-200' : item.daysLeft <= 14 ? 'bg-amber-50/95 text-amber-700 border-amber-200' : 'bg-white/95 text-slate-500 border-slate-200'}`)
                          span(class=`w-1.5 h-1.5 rounded-full flex-shrink-0 ${item.daysLeft <= 7 ? 'bg-red-500 animate-pulse' : item.daysLeft <= 14 ? 'bg-amber-400' : 'bg-slate-300'}`)
                          span(class="font-mono font-semibold tabular-nums" data-ends-at=item.endsAt)= item.timeLeft

                  div(class="p-4 flex flex-col flex-1")
                    h3(class="text-sm font-semibold text-slate-900 leading-snug mb-3 line-clamp-2")
                      a(href=`/auction/${item.id}`)= item.title

                    div(class="mt-auto space-y-3")
                      div
                        div(class="text-[10px] font-medium text-slate-400 uppercase tracking-widest mb-0.5") Alghind
                        div(class="text-lg font-black text-slate-900 font-mono tracking-tight tabular-nums")= item.startingPrice

                      div(class="flex items-center justify-between pt-3 border-t border-slate-100")
                        if item.catastralUnits.length
                          div(class="min-w-0 max-w-[130px]")
                            each unit in item.catastralUnits
                              a(href=`https://xgis.maaamet.ee/xgis2/page/app/maainfo?searchid=FUUKAT101x2&TUNNUS=${unit}` target="_blank" rel="noopener noreferrer" title=unit class="block text-xs text-blue-500 hover:text-blue-700 font-mono transition-colors truncate")= unit
                        else
                          span
                        a(href=item.url target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 px-3 py-1.5 bg-slate-900 text-white text-xs font-semibold rounded-lg hover:bg-slate-700 transition-colors duration-150")
                          | Vaata
                          i(data-lucide="external-link" style="width:11px;height:11px")

            if hasMore
              div#load-more-sentinel(class="flex items-center justify-center gap-1.5 py-8 text-xs text-slate-400" data-page=page)
                i(data-lucide="loader-2" style="width:14px;height:14px" class="animate-spin")
                span Laen rohkem...

    script.
      lucide.createIcons();

      function formatCountdown(ms) {
        const totalSeconds = Math.max(0, Math.floor(ms / 1000));
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        if (days > 0) return `${days} p, ${hours} h ${minutes} m`;
        return `${hours} h ${minutes} m ${seconds} s`;
      }

      function tickCountdowns() {
        const now = Date.now();
        document.querySelectorAll('[data-ends-at]').forEach((el) => {
          el.textContent = formatCountdown(new Date(el.dataset.endsAt).getTime() - now);
        });
      }

      tickCountdowns();
      setInterval(tickCountdowns, 1000);

      function toggleSidebar() {
        document.getElementById('filter-sidebar').classList.toggle('hidden');
        document.getElementById('filter-sidebar').classList.toggle('flex');
        document.getElementById('sidebar-backdrop').classList.toggle('hidden');
      }

      function toggleScrapeMenu() {
        document.getElementById('scrape-menu').classList.toggle('hidden');
      }

      async function scrapeNow(full = false) {
        document.getElementById('scrape-menu').classList.add('hidden');
        const btn = document.getElementById('scrape-btn');
        const label = btn.querySelector('span');
        const originalLabel = label.textContent;

        btn.disabled = true;
        label.textContent = 'Uuendan...';

        try {
          await fetch(full ? '/scrape?full=1' : '/scrape', { method: 'POST' });
          await refreshListings();
          label.textContent = 'Uuendatud';
        } catch (err) {
          console.error('Scrape request failed:', err);
        } finally {
          setTimeout(() => {
            label.textContent = originalLabel;
            btn.disabled = false;
          }, 1500);
        }
      }

      async function refreshListings() {
        const res = await fetch(window.location.pathname + window.location.search);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');

        document.querySelector('main').replaceWith(doc.querySelector('main'));
        document.getElementById('stats-bar').replaceWith(doc.getElementById('stats-bar'));

        lucide.createIcons();
        setupLoadMoreObserver();
      }

      let loadMoreObserver = null;

      function setupLoadMoreObserver() {
        if (loadMoreObserver) loadMoreObserver.disconnect();

        const sentinel = document.getElementById('load-more-sentinel');
        if (!sentinel) return;

        loadMoreObserver = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting) loadMore();
        }, { rootMargin: '400px' });

        loadMoreObserver.observe(sentinel);
      }

      async function loadMore() {
        const sentinel = document.getElementById('load-more-sentinel');
        if (!sentinel || sentinel.dataset.loading === 'true') return;
        sentinel.dataset.loading = 'true';

        const nextPage = Number(sentinel.dataset.page) + 1;
        const params = new URLSearchParams(window.location.search);
        params.set('page', nextPage);

        const res = await fetch(window.location.pathname + '?' + params.toString());
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');

        const grid = document.getElementById('auction-grid');
        doc.querySelectorAll('#auction-grid > article').forEach((article) => grid.appendChild(article));

        const newSentinel = doc.getElementById('load-more-sentinel');
        if (newSentinel) {
          sentinel.dataset.page = nextPage;
          sentinel.dataset.loading = 'false';
        } else {
          loadMoreObserver.disconnect();
          sentinel.remove();
        }

        lucide.createIcons();
      }

      const searchInput = document.querySelector('input[name="search"]');
      let searchDebounce = null;
      let lastLiveSearch = searchInput.value.trim();

      searchInput.addEventListener('input', () => {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(applyLiveSearch, 300);
      });

      async function applyLiveSearch() {
        const value = searchInput.value.trim();
        if (value.length > 0 && value.length < 3) return;
        if (value === lastLiveSearch) return;
        lastLiveSearch = value;

        const params = new URLSearchParams(window.location.search);
        if (value) params.set('search', value); else params.delete('search');
        params.delete('page');
        const qs = params.toString();
        history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));
        await refreshListings();
      }

      setupLoadMoreObserver();
