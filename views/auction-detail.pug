doctype html
html(lang="et")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= auction.title + ' — OksjonTrack'
    script(src="https://cdn.tailwindcss.com")
    script(src="https://unpkg.com/lucide@latest")
  body(class="min-h-screen bg-slate-50" style="font-family: system-ui, -apple-system, sans-serif")
    main(class="max-w-4xl mx-auto p-5 space-y-5")
      a(href="/" class="inline-flex items-center gap-2 px-3.5 py-2 bg-white border border-slate-200 rounded-xl shadow-sm text-sm font-semibold text-slate-700 hover:text-slate-900 hover:border-slate-300 transition-colors")
        i(data-lucide="arrow-left" style="width:15px;height:15px")
        | Tagasi

      div(class="bg-white rounded-2xl border border-slate-200 overflow-hidden")
        if images.length
          div(class="grid grid-cols-2 sm:grid-cols-3 gap-1 bg-slate-100")
            each img, idx in images
              button(type="button" data-lightbox-open=idx class="block aspect-[4/3] overflow-hidden cursor-zoom-in")
                img(src=img.thumb alt="" loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300")
        else
          div(class="h-48 bg-slate-100 flex flex-col items-center justify-center gap-2 text-slate-300")
            i(data-lucide="image-off" style="width:32px;height:32px")
            span(class="text-xs") Pilte pole veel laaditud

        div(class="p-5")
          if detail && detail.status
            div(class="inline-flex items-center gap-1.5 px-2.5 py-1 mb-3 rounded-lg border border-red-200 bg-red-50 text-red-700 text-xs font-bold uppercase tracking-wide")
              i(data-lucide="alert-triangle" style="width:13px;height:13px")
              span= detail.status
          h1(class="text-lg font-semibold text-slate-900 mb-3")= auction.title

          div(class="flex items-center gap-5 flex-wrap")
            div
              div(class="text-[10px] font-medium text-slate-400 uppercase tracking-widest mb-0.5") Alghind
              div(class="text-xl font-black text-slate-900 font-mono tracking-tight tabular-nums")= auction.startingPrice
            if detail && detail.current_price
              div
                div(class="text-[10px] font-medium text-slate-400 uppercase tracking-widest mb-0.5") Hetkehind
                div(class="text-xl font-black text-slate-900 font-mono tracking-tight tabular-nums")= detail.current_price
            div
              div(class="text-[10px] font-medium text-slate-400 uppercase tracking-widest mb-0.5")= auction.upcoming ? 'Algab' : 'Aega jäänud'
              div(class="text-sm font-semibold text-slate-700 font-mono tabular-nums")= auction.timeLeft

            a(href=auction.url target="_blank" rel="noopener noreferrer" class="ml-auto inline-flex items-center gap-1.5 px-4 py-2 bg-slate-900 text-white text-sm font-semibold rounded-lg hover:bg-slate-700 transition-colors")
              | Vaata oksjonikeskuses
              i(data-lucide="external-link" style="width:13px;height:13px")

      if priceHistory.length > 1
        div(class="bg-white rounded-2xl border border-slate-200 p-5")
          h2(class="text-sm font-semibold text-slate-900 uppercase tracking-wide mb-3") Hinna ajalugu
          ul(class="text-sm divide-y divide-slate-100")
            each entry, idx in priceHistory
              li(class="flex items-center justify-between py-2")
                span(class=idx === 0 ? "font-mono font-semibold text-slate-900 tabular-nums" : "font-mono text-slate-400 tabular-nums")= entry.price
                span(class="text-xs text-slate-400")= entry.date

      if detail
        div(class="bg-white rounded-2xl border border-slate-200 p-5")
          h2(class="text-sm font-semibold text-slate-900 uppercase tracking-wide mb-3") Andmed
          dl(class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm")
            if detail.address
              div
                dt(class="text-[11px] text-slate-400 uppercase tracking-widest") Aadress
                dd= detail.address
            if detail.city
              div
                dt(class="text-[11px] text-slate-400 uppercase tracking-widest") Linn / vald
                dd= detail.city
            if auction.catastralUnits.length
              div
                dt(class="text-[11px] text-slate-400 uppercase tracking-widest") Katastritunnus
                dd
                  each unit in auction.catastralUnits
                    div
                      a(href=`https://xgis.maaamet.ee/xgis2/page/app/maainfo?searchid=FUUKAT101x2&TUNNUS=${unit}` target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:text-blue-700 font-mono")= unit
            if detail.deposit
              div
                dt(class="text-[11px] text-slate-400 uppercase tracking-widest") Tagatisraha
                dd= detail.deposit
            if detail.registration_start
              div
                dt(class="text-[11px] text-slate-400 uppercase tracking-widest") Registreerimine algab
                dd= detail.registration_start
            if detail.registration_end
              div
                dt(class="text-[11px] text-slate-400 uppercase tracking-widest") Registreerimine lõpeb
                dd= detail.registration_end
            if detail.auction_start
              div
                dt(class="text-[11px] text-slate-400 uppercase tracking-widest") Oksjon algab
                dd= detail.auction_start
            if detail.auction_end
              div
                dt(class="text-[11px] text-slate-400 uppercase tracking-widest") Oksjon lõpeb
                dd= detail.auction_end

        if detail.announcement_body
          div(class="bg-white rounded-2xl border border-slate-200 p-5")
            h2(class="text-sm font-semibold text-slate-900 uppercase tracking-wide mb-3") Teadaanne
            if detail.announcement_header
              h3(class="text-sm font-semibold text-slate-800 mb-1")= detail.announcement_header
            p(class="text-sm text-slate-600 whitespace-pre-line mb-3")= detail.announcement_body
            div(class="flex flex-col gap-2 text-[11px] text-slate-400")
              if detail.announcement_date
                div(class="whitespace-pre-line")= detail.announcement_date
              if detail.announcement_number
                div= detail.announcement_number
              if detail.announcement_provider
                div(class="whitespace-pre-line")= detail.announcement_provider
              if detail.announcement_publisher
                div(class="whitespace-pre-line")= detail.announcement_publisher
      else
        div(class="bg-white rounded-2xl border border-slate-200 p-5 text-sm text-slate-400")
          | Selle oksjoni detailandmeid pole veel laaditud. Need lisatakse järgmise taustaskaneeringu käigus.

    if images.length
      div(id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm")
        button(id="lightbox-close" type="button" class="absolute top-4 right-4 p-2 rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors")
          i(data-lucide="x" style="width:24px;height:24px")

        button(id="lightbox-prev" type="button" class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 p-2 rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors")
          i(data-lucide="chevron-left" style="width:32px;height:32px")

        button(id="lightbox-next" type="button" class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 p-2 rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors")
          i(data-lucide="chevron-right" style="width:32px;height:32px")

        img(id="lightbox-image" src="" alt="" class="max-w-[92vw] max-h-[85vh] object-contain rounded-lg shadow-2xl select-none")

        div(id="lightbox-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-white/10 text-white/80 text-xs font-medium tabular-nums")

    script.
      lucide.createIcons();

    if images.length
      script.
        const lightboxImages = !{JSON.stringify(images.map((img) => img.full)).replace(/</g, '\\u003c')};
        const lightbox = document.getElementById('lightbox');
        const lightboxImage = document.getElementById('lightbox-image');
        const lightboxCounter = document.getElementById('lightbox-counter');
        let currentIndex = 0;

        function showImage(index) {
          currentIndex = (index + lightboxImages.length) % lightboxImages.length;
          lightboxImage.src = lightboxImages[currentIndex];
          lightboxCounter.textContent = `${currentIndex + 1} / ${lightboxImages.length}`;
        }

        function openLightbox(index) {
          showImage(index);
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
          lightbox.classList.add('hidden');
          lightbox.classList.remove('flex');
          document.body.style.overflow = '';
        }

        document.querySelectorAll('[data-lightbox-open]').forEach((el) => {
          el.addEventListener('click', () => openLightbox(Number(el.dataset.lightboxOpen)));
        });

        document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
        document.getElementById('lightbox-prev').addEventListener('click', () => showImage(currentIndex - 1));
        document.getElementById('lightbox-next').addEventListener('click', () => showImage(currentIndex + 1));

        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) closeLightbox();
        });

        document.addEventListener('keydown', (e) => {
          if (lightbox.classList.contains('hidden')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
          if (e.key === 'ArrowRight') showImage(currentIndex + 1);
        });
